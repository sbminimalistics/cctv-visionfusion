{
    "name": "dashboard",
    "version": "1.0.0",
    "description": "",
    "main": "app.ts",
    "type": "module",
    "scripts": {
        "start": "node --import ./dist/instrumentation.js dist/app.js",
        "dev": "tsx watch src/app.ts",
        "build": "esbuild src/app.ts --bundle --platform=node --target=node24 --format=esm --outfile=dist/app.js --external:amqplib --external:dotenv & esbuild src/instrumentation.ts --target=node24 --format=esm --outfile=dist/instrumentation.js",
        "test": "echo \"Error: no test specified\" && exit 1"
    },
    "author": "",
    "license": "ISC",
    "dependencies": {
        "@hono/node-server": "^2.1.5",
        "@opentelemetry/api": "^1.10.0",
        "@opentelemetry/auto-instrumentations-node": "^0.83.1",
        "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
        "@opentelemetry/instrumentation-amqplib": "^0.72.0",
        "@opentelemetry/instrumentation-http": "^0.301.2",
        "@opentelemetry/resources": "^3.1.1",
        "@opentelemetry/sdk-node": "^0.301.2",
        "@opentelemetry/semantic-conventions": "^1.45.0",
        "amqplib": "^2.2.0",
        "dotenv": "^18.0.7",
        "fast-xml-parser": "^5.11.2",
        "hono": "^4.13.13",
        "pino": "^10.4.0",
        "postgres": "^3.4.9",
        "ts-proto": "^2.18.0"
    },
    "devDependencies": {
        "@types/amqplib": "^0.10.8",
        "@types/node": "^26.6.5",
        "esbuild": "^0.28.2",
        "tsx": "^4.23.15"
    }
}
