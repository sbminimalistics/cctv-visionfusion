{
  "rabbit_version": "4.0.0",
  "vhosts": [
    {
      "name": "vms"
    }
  ],
  "exchanges": [
    {
      "name": "devices.events.topic",
      "vhost": "vms",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "processor.triggers.topic",
      "vhost": "vms",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "dashboard_feed",
      "vhost": "vms",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 5000,
        "x-overflow": "drop-head",
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "dashboard_triggers",
      "vhost": "vms",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 5000,
        "x-overflow": "drop-head",
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "image_refs",
      "vhost": "vms",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 5000,
        "x-overflow": "drop-head",
        "x-message-ttl": 86400000
      }
    }
  ],
  "bindings": [
    {
      "source": "devices.events.topic",
      "vhost": "vms",
      "destination": "dashboard_feed",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    },
    {
      "source": "processor.triggers.topic",
      "vhost": "vms",
      "destination": "dashboard_triggers",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    }
  ]
}
