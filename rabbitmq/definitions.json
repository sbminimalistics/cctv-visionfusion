{
  "rabbit_version": "4.0.0",
  "vhosts": [
    {
      "name": "cctv-vf"
    }
  ],
  "exchanges": [
    {
      "name": "devices.events.topic",
      "vhost": "cctv-vf",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "processor.triggers.topic",
      "vhost": "cctv-vf",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    },
    {
      "name": "requests.download.screenshot",
      "vhost": "cctv-vf",
      "type": "topic",
      "durable": true,
      "auto_delete": false,
      "internal": false,
      "arguments": {}
    }
  ],
  "queues": [
    {
      "name": "dashboard_feed",
      "vhost": "cctv-vf",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 5000,
        "x-overflow": "drop-head",
        "x-message-ttl": 86400000
      }
    },
    {
        "name": "dashboard_triggers",
        "vhost": "cctv-vf",
        "durable": true,
        "auto_delete": false,
        "arguments": {
            "x-max-length": 5000,
            "x-overflow": "drop-head",
            "x-message-ttl": 86400000
        }
    },
    {
      "name": "downloader_feed",
      "vhost": "cctv-vf",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 5000,
        "x-overflow": "drop-head",
        "x-message-ttl": 86400000
      }
    },
    {
      "name": "image_refs",
      "vhost": "cctv-vf",
      "durable": true,
      "auto_delete": false,
      "arguments": {
        "x-max-length": 5000,
        "x-overflow": "drop-head",
        "x-message-ttl": 86400000
      }
    }
  ],
  "bindings": [
    {
      "source": "devices.events.topic",
      "vhost": "cctv-vf",
      "destination": "dashboard_feed",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    },
    {
        "source": "processor.triggers.topic",
        "vhost": "cctv-vf",
        "destination": "dashboard_triggers",
        "destination_type": "queue",
        "routing_key": "#",
        "arguments": {}
    },
    {
      "source": "requests.download.screenshot",
      "vhost": "cctv-vf",
      "destination": "downloader_feed",
      "destination_type": "queue",
      "routing_key": "#",
      "arguments": {}
    }
  ]
}
